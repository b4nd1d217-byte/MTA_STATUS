# Required Discord application settings
DISCORD_TOKEN=
CLIENT_ID=
# Optional: restrict command registration to one test guild for instant updates
GUILD_ID=

# Required: use a long random secret (at least 32 characters). Set the same value in MTA apiSecret.
API_SECRET=
# Optional override. If empty, the bot reuses API_SECRET.
MTA_API_SECRET=

# PostgreSQL is required for durable panels, tickets and settings on Render.
DATABASE_URL=
# Optional on some hosted PostgreSQL providers
PGSSL=true

# Optional: set to the public URL of the GIF hosted at /assets/dripx-shop-logo.gif
LOGO_URL=
# Comma-separated Discord user IDs allowed to bypass normal admin role checks
ADMIN_USER_IDS=

NODE_ENV=development
PORT=3000